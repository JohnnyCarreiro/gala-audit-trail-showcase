# Block local merges into dev/main per docs/playbook.md (Git Flow strict from day 1).
# Merges into dev/main happen via PR on GitHub, not locally.

branch=$(git rev-parse --abbrev-ref HEAD)

if [ "$branch" = "dev" ] || [ "$branch" = "main" ]; then
  echo ""
  echo "❌  Local merges into '$branch' are blocked by policy."
  echo "    Use a Pull Request on GitHub. See docs/playbook.md."
  echo ""
  echo "    Override (rare exception, owner-only):"
  echo "      git merge --no-verify"
  echo ""
  echo "    Disable all hooks for this shell session:"
  echo "      HUSKY=0 git merge ..."
  echo ""
  exit 1
fi
