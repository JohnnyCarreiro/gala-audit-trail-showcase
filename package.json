{
  "name": "gala-audit-trail-showcase",
  "private": true,
  "type": "module",
  "description": "On-chain audit trail for game sessions on GalaChain — TypeScript chaincode + Next.js frontend + Rust off-chain verifier.",
  "license": "MIT",
  "engines": {
    "bun": ">=1.3",
    "node": ">=22"
  },
  "packageManager": "bun@1.3.6",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit && tsc -p packages/result-helpers/tsconfig.json --noEmit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@types/bun": "^1.3.13",
    "husky": "^9.1.7",
    "typescript": "^5.6.0"
  }
}
